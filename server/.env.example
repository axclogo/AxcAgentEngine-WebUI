# openai: each agent uses the provider models configured in the UI; fixture: deterministic offline model for every agent.
AXC_MODEL_MODE=openai
# Data directory: workbench.db, secret.key, skills/, knowledge/, agents/, agent-skills/, attachments/
AXC_DATA=./data
# Optional database path override (defaults to $AXC_DATA/workbench.db)
# AXC_DB=./data/workbench.db
# Fernet key for provider API keys. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, a key is generated into $AXC_DATA/secret.key (0600).
AXC_SECRET_KEY=
# 0 disables first-start demo data (agents, skill, knowledge base, graph)
AXC_SEED=1
