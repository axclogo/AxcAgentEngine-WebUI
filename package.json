{
  "name": "@axc/agent-workbench",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "docs/*.md",
    "examples/*.tsx",
    "server/**/*.py",
    "server/requirements.txt",
    "server/.env.example"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && postcss src/styles.css -o dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vite --host 127.0.0.1",
    "build:app": "npm run build && vite build",
    "prepack": "npm run build",
    "test:package": "node scripts/package-check.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.38",
    "@hookform/resolvers": "^7.0.9",
    "@streamdown/code": "2.0.1",
    "@streamdown/mermaid": "1.0.4",
    "@tanstack/react-query": "^5.108.4",
    "@xyflow/react": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.79.0",
    "radix-ui": "^1.8.1",
    "react-dropzone": "^20.2.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "streamdown": "2.8.0",
    "tailwind-merge": "^3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
